.claude/settings.local.json
.claude/agent-memory-local/

# Secrets. The Velocity forwarding secret only ever travels through the
# secret store — never a definition YAML, a log line, or a fixture.
*.env
.env
secrets/
*forwarding.secret

# Local dev containerd state
.dev/
